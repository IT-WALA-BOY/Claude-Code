# Workflow Dashboard (Apache / Hostinger / XAMPP)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private folders and files
  RewriteRule ^(app|pages|partials|database|storage|tools|docs|\.git|\.claude)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|CLAUDE\.md|README\.md)$ - [F,L]
  # Everything that is not a real file goes to index.php
  # Missing files under assets/ are a plain 404, everything else goes to index.php
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Versioned URLs (?v=) are cached for a year; anything else is revalidated.
  <FilesMatch "\.(css|js|svg|woff2|png|jpg|webp)$">
    Header set Cache-Control "no-cache"
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType text/javascript .js
</IfModule>
